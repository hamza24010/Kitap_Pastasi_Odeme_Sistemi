{
  "name": "kitap-pastasi-pos",
  "private": true,
  "version": "1.0.0",
  "description": "Kitap Pastası POS Sistemi",
  "author": "Kitap Pastası",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "wait-on tcp:3000 && electron .",
    "electron:dev": "concurrently -k \"npm run dev\" \"npm run electron\"",
    "electron:build": "npm run build && electron-builder build --win"
  },
  "dependencies": {
    "lucide-react": "^0.556.0",
    "react": "^17.0.2",
    "react-dom": "^17.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^17.0.39",
    "@types/react-dom": "^17.0.11",
    "@vitejs/plugin-react": "^1.3.2",
    "concurrently": "^9.2.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "typescript": "~4.5.5",
    "vite": "^2.9.15",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.kitappastasi.pos",
    "productName": "Kitap Pastası POS",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
